{
  "name": "Retry Handler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 5 }]
        }
      },
      "id": "b2c3d4e5-0001-0001-0001-000000000001",
      "name": "Schedule: Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, url, retries, max_retries, metadata\nFROM jobs\nWHERE status = 'failed'\n  AND retries < max_retries\n  AND updated_at < NOW() - (INTERVAL '1 minute' * POWER(2, retries))\nORDER BY updated_at ASC\nLIMIT 10;",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Fetch Failed Jobs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "scraper-postgres",
          "name": "Scraper Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "b2c3d4e5-0003-0003-0003-000000000003",
      "name": "Any jobs to retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b2c3d4e5-0004-0004-0004-000000000004",
      "name": "Split Into Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "// Calculate exponential backoff delay (already filtered in SQL)\n// Mark job as running before retrying\nconst job = $input.first().json;\nconst retryDelay = Math.pow(2, job.retries) * 60 * 1000; // ms\n\nreturn [{\n  json: {\n    job_id: job.id,\n    url: job.url,\n    retries: job.retries,\n    retry_delay_ms: retryDelay,\n    javascript: true,\n    timeout_ms: 45000,\n  }\n}];"
      },
      "id": "b2c3d4e5-0005-0005-0005-000000000005",
      "name": "Prepare Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE jobs\nSET status = 'running', updated_at = NOW()\nWHERE id = '{{ $json.job_id }}';",
        "options": {}
      },
      "id": "b2c3d4e5-0006-0006-0006-000000000006",
      "name": "Mark Running",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1340, 200],
      "credentials": {
        "postgres": {
          "id": "scraper-postgres",
          "name": "Scraper Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SCRAPER_API_URL || 'http://scraper-api:8000' }}/scrape/",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "url", "value": "={{ $('Prepare Retry').first().json.url }}" },
            { "name": "javascript", "value": "={{ $('Prepare Retry').first().json.javascript }}" },
            { "name": "timeout_ms", "value": "={{ $('Prepare Retry').first().json.timeout_ms }}" }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "b2c3d4e5-0007-0007-0007-000000000007",
      "name": "Retry Scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE jobs\nSET status = 'done',\n    retries = retries + 1,\n    updated_at = NOW()\nWHERE id = '{{ $('Prepare Retry').first().json.job_id }}';",
        "options": {}
      },
      "id": "b2c3d4e5-0008-0008-0008-000000000008",
      "name": "Mark Done",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1780, 200],
      "credentials": {
        "postgres": {
          "id": "scraper-postgres",
          "name": "Scraper Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE jobs\nSET retries = retries + 1,\n    status = CASE\n      WHEN retries + 1 >= max_retries THEN 'dead'\n      ELSE 'failed'\n    END,\n    updated_at = NOW()\nWHERE id = '{{ $('Prepare Retry').first().json.job_id }}';\n\n-- Move to dead letter if exhausted\nINSERT INTO dead_letter (job_id, url, error, payload)\nSELECT id, url,\n       'Max retries exhausted after ' || (retries + 1) || ' attempts',\n       metadata\nFROM jobs\nWHERE id = '{{ $('Prepare Retry').first().json.job_id }}'\n  AND retries + 1 >= max_retries;",
        "options": {}
      },
      "id": "b2c3d4e5-0009-0009-0009-000000000009",
      "name": "Mark Failed / Dead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1780, 400],
      "credentials": {
        "postgres": {
          "id": "scraper-postgres",
          "name": "Scraper Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// No jobs to retry — exit silently\nreturn [];"
      },
      "id": "b2c3d4e5-0010-0010-0010-000000000010",
      "name": "No-op (nothing to retry)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Schedule: Every 5 min": {
      "main": [[{ "node": "Fetch Failed Jobs", "type": "main", "index": 0 }]]
    },
    "Fetch Failed Jobs": {
      "main": [[{ "node": "Any jobs to retry?", "type": "main", "index": 0 }]]
    },
    "Any jobs to retry?": {
      "main": [
        [{ "node": "Split Into Items", "type": "main", "index": 0 }],
        [{ "node": "No-op (nothing to retry)", "type": "main", "index": 0 }]
      ]
    },
    "Split Into Items": {
      "main": [[{ "node": "Prepare Retry", "type": "main", "index": 0 }]]
    },
    "Prepare Retry": {
      "main": [[{ "node": "Mark Running", "type": "main", "index": 0 }]]
    },
    "Mark Running": {
      "main": [[{ "node": "Retry Scrape", "type": "main", "index": 0 }]]
    },
    "Retry Scrape": {
      "main": [[{ "node": "Mark Done", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true,
    "executionOrder": "v1",
    "errorWorkflow": ""
  },
